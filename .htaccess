# ========================================================
# 1. KEAMANAN: Matikan Directory Browsing (Mencegah Intip Folder)
# ========================================================
Options -Indexes

# ========================================================
# 2. BLOKIR AKSES FILE SENSITIF
# ========================================================
# Blokir file database (.sql), log, config, yaml, env
<FilesMatch "(^#.*#|\.(bak|config|sql|fla|psd|ini|log|sh|inc|swp|dist|yml|yaml|env)|~)$">
    Require all denied
</FilesMatch>

# Blokir file tersembunyi berawalan titik (.git, .gitignore, .htaccess)
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# ========================================================
# 3. ROUTING & PROTEKSI DIREKTORI
# ========================================================
RewriteEngine On

# Blokir akses langsung ke folder internal (includes, _development_scripts, dll)
RewriteRule ^(includes|_development_scripts|\.agents|\.git)/.*$ - [F,L,NC]

# Blokir akses langsung ke db.php dari URL browser
RewriteRule ^db\.php$ - [F,L,NC]

# Redirect Easter Egg (Meet Your Maker)
RewriteRule ^meetyourmaker/?$ http://www.linkedin.com/in/bagusikapraja [R=301,L,NC]

# Redirect /login secara aman via login.php (mencegah error path cPanel /home/library/public_html/)
RewriteRule ^login/?$ login.php [L,NC]

# SEO Friendly Routing for News
RewriteRule ^berita/([^/]+)/?$ detail-berita.php?slug=$1 [QSA,NC,L]

# Jangan terapkan aturan ini pada file atau direktori yang benar-benar ada
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.php -f

# Sembunyikan ekstensi .php
RewriteRule ^([^\.]+)$ $1.php [NC,L]

# ========================================================
# 4. CACHE CONTROL (Mencegah NGINX & Browser Menyimpan HTML/PHP Basi)
# ========================================================
<IfModule mod_headers.c>
    <FilesMatch "\.(php|html)$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires 0
    </FilesMatch>
</IfModule>

# ========================================================
# 5. CUSTOM ERROR PAGES (UI Error 400, 403, 404, 500)
# ========================================================
ErrorDocument 400 /error.php?code=400
ErrorDocument 403 /error.php?code=403
ErrorDocument 404 /error.php?code=404
ErrorDocument 500 /error.php?code=500
