RewriteEngine On
RewriteBase /

# Redirect Easter Egg (Meet Your Maker)
RewriteRule ^meetyourmaker/?$ http://www.linkedin.com/in/bagusikapraja [R=301,L,NC]

# Redirect /login to /admin/login
RewriteRule ^login/?$ admin/login [R=301,L,NC]

# SEO Friendly Routing for News
RewriteRule ^berita/([a-zA-Z0-9-]+)/?$ detail-berita.php?slug=$1 [QSA,NC,L]

# Jangan terapkan aturan ini pada file atau direktori yang benar-benar ada
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f

# Sembunyikan ekstensi .php
RewriteRule ^([^\.]+)$ $1.php [NC,L]
